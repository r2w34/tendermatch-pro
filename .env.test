NODE_ENV=test
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/tender_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_GEM_URL=https://gem.gov.in
TEST_CPPP_URL=https://eprocure.gov.in
TEST_GEMINI_API_KEY=test_key_here
SCRAPING_DELAY=2000
MAX_RETRIES=3

# Test API Configuration
TEST_API_BASE_URL=http://localhost:5000
TEST_JWT_SECRET=test_jwt_secret_key_for_testing_only
TEST_BCRYPT_ROUNDS=1

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=tender_test
TEST_DB_USER=test
TEST_DB_PASSWORD=test

# Test Redis Configuration
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_DB=1

# Test Email Configuration
TEST_EMAIL_SERVICE=test
TEST_EMAIL_USER=test@example.com
TEST_EMAIL_PASS=testpass

# Test File Upload Configuration
TEST_UPLOAD_DIR=./tests/fixtures/uploads
TEST_MAX_FILE_SIZE=10485760

# Test Rate Limiting
TEST_RATE_LIMIT_WINDOW=900000
TEST_RATE_LIMIT_MAX=100

# Test Scraping Configuration
TEST_SCRAPING_USER_AGENT=TenderMatch-Test-Bot/1.0
TEST_SCRAPING_CONCURRENT_LIMIT=2
TEST_SCRAPING_REQUEST_DELAY=1000

# Test AI Configuration
TEST_AI_ENABLED=false
TEST_AI_MOCK_RESPONSES=true

# Test Performance
TEST_PERFORMANCE_THRESHOLD_MS=5000
TEST_MEMORY_THRESHOLD_MB=100