# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/tendermatch_pro
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tendermatch_pro
DB_USER=your_username
DB_PASSWORD=your_password

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (for future authentication)
JWT_SECRET=your_jwt_secret_here

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# External APIs (for future integrations)
GEM_PORTAL_API_KEY=your_gem_portal_api_key
EPROCURE_API_KEY=your_eprocure_api_key

# Logging
LOG_LEVEL=info