# Production Environment Variables for TenderMatch Pro

# API Configuration
REACT_APP_API_URL=https://api.tendermatch.pro
REACT_APP_ENVIRONMENT=production

# AI Services
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
REACT_APP_HOTJAR_ID=your_hotjar_id

# Payment Gateway
REACT_APP_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx

# CDN and Assets
REACT_APP_CDN_URL=https://cdn.tendermatch.pro
REACT_APP_ASSETS_URL=https://assets.tendermatch.pro

# Feature Flags
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true

# Security
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_HSTS=true

# Performance
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_ENABLE_CODE_SPLITTING=true
REACT_APP_ENABLE_LAZY_LOADING=true

# Monitoring
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
REACT_APP_ENABLE_ERROR_TRACKING=true

# Social Login
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id